# Copy to .env and fill in. See docs/setup/accounts-and-keys.md
# --- Instagram (Meta developer app, Instagram Login path) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_APPROVAL_CHANNEL_ID=
# Comma-separated Discord user ids whose reactions count as verdicts (you, other officers)
DISCORD_APPROVERS=
# --- Image host: the GitHub Pages branch of this repo (already set up) ---
PAGES_OWNER=paihanhuang
PAGES_REPO=rocket-club-instagram
PAGES_BRANCH=gh-pages
PAGES_DIR=media
# Optional: a GitHub token; when empty the `gh` CLI's login is used
GITHUB_TOKEN=
# --- Local model server (MTPLX). Defaults match qwen code's settings ---
LOCAL_LLM_BASE_URL=http://127.0.0.1:18085/v1
LOCAL_LLM_API_KEY=local-no-auth
LOCAL_LLM_MODEL=mtplx-qwen38-27b-optimized-quality
LOCAL_LLM_MTPLX_MODEL=Youssofal/Qwen3.8-27B-MTPLX-Optimized-Quality
# Writer harness: qwen (qwen code headless, tools disabled), http (direct), auto
WRITER_MODEL=qwen
